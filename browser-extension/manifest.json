{
  "manifest_version": 3,
  "name": "Always With You · 记录助手",
  "short_name": "Always With You",
  "version": "0.2.0",
  "description": "只告诉「一个时刻陪着你的AI」你正在看哪个网页（https 网址去掉参数、域名、标题、搜索词）。不读网页内容和输入框。数据只发给本机程序。",
  "key": "",
  "permissions": [
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:47823/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "incognito": "not_allowed",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}